{
  "name": "dsh-plugin-cost-guard",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: at-a-glance peak/off-peak token cost indicator with context-cache estimation",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cost",
    "peak",
    "off-peak",
    "token"
  ],
  "author": "Cristian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbittel/dsh-plugin-cost-guard.git"
  },
  "homepage": "https://github.com/cbittel/dsh-plugin-cost-guard#readme",
  "bugs": {
    "url": "https://github.com/cbittel/dsh-plugin-cost-guard/issues"
  }
}
